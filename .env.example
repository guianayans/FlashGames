# Copie para .env e ajuste antes de subir (no Coolify, defina essas variaveis
# na aba Environment Variables do app em vez de um arquivo .env).

# String aleatoria longa usada para assinar o cookie de sessao (login).
# Gere uma com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Dominio publico do app (usado no CORS). Ajuste se mudar o dominio no Traefik.
CORS_ORIGIN=https://flashgames.gvtserver.online

# —— Painel admin (/admin) ——
PUBLIC_URL="https://flashgames.gvtserver.online"
APP_NAME="FlashGames"
# Quem recebe o código de login do painel (separados por vírgula)
ADMIN_EMAILS="yanguimaraesviana@gmail.com"
ADMIN_SESSION_HOURS=12

# —— E-mail (código do painel) ——
# Sem SMTP_HOST, os códigos vão só para o log da api (bom para desenvolvimento).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="FlashGames"
